{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/exxat-graphify-gate.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: graph exists (gitignored). Run graphify query \\\"<question>\\\" --budget 1200 before grepping. Do not Glob graphify-out or read GRAPH_REPORT.md in full.\"}}'   || true ;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/exxat-brief-gate.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/exxat-session-status.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/exxat-image-ia-gate.mjs"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/react-doctor.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/exxat-ds-check.mjs\""
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Agent(model:claude-opus-4-8)",
      "Agent(model:claude-sonnet-4-6)",
      "Agent(model:claude-sonnet-5*)"
    ],
    "deny": [
      "Agent(model:claude-haiku*)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -fd *)",
      "Bash(git stash drop *)",
      "Bash(git commit --amend *)"
    ]
  }
}
