# TypeSafe AI key for the optional import assist. Server-side only: never prefix with NEXT_PUBLIC_, never commit a real key.
# Without a key the import runs on the standard reader and the "Use AI" switch is not shown.
TYPESAFE_API_KEY=
# off | (unset): "off" disables the AI assist even when a key is present.
SKILLS_IMPORT_AI=
# Pinned model version for stable thresholds (jev-latest is an alias of it today).
TYPESAFE_IMPORT_MODEL=jev-1.13.0
# Demo cost guard: interpret calls per server instance per UTC day.
SKILLS_IMPORT_DAILY_CAP=200
# Test-only: 1 swaps the network for SYNTHETIC answers (no key needed). Never set in a real deployment.
TYPESAFE_MOCK=
