{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/romitsoley/Work/.codex/hooks/exxat-graphify-gate.mjs'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: graph exists (gitignored). Run graphify query \\\"<question>\\\" --budget 1200 before grepping. Do not Glob graphify-out or read GRAPH_REPORT.md in full.\"}}'   || true ;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/romitsoley/Work/.codex/hooks/exxat-brief-gate.mjs'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/pre-tool-use.py'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/romitsoley/Work/.codex/hooks/pre-edit-checks.mjs'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/post-edit-checks.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/pre-compact.py'",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/romitsoley/Work/.codex/hooks/exxat-session-status.mjs'"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/session-start.py'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/romitsoley/Work/.codex/hooks/exxat-image-ia-gate.mjs'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/user-prompt-submit.py'",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/subagent-stop.py'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/ds-claim-gate.py'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/vault-citation-gate.py'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/romitsoley/Work/.codex/hooks/vault-capture-reminder.py'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
